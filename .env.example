# ── Service Memory Copilot 环境变量模板 ──────────────────────
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会进版本库。

# 模型服务（OpenAI Chat Completions 兼容协议）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 语义引擎模式：hybrid（默认）| llm_only | rule_only
SEMANTIC_MODE=hybrid

# 单次请求超时（毫秒）
LLM_TIMEOUT_MS=30000

# 时区（影响演示时间线，保持默认即可）
TZ=Asia/Shanghai
